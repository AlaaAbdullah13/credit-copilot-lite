# # Server & Environment Configuration
# ENV=development
# PORT=8000
# LOG_LEVEL=INFO

# # LLM Configuration (Adapter Pattern)
# # Options: gemini | groq | ollama | fake
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# OLLAMA_BASE_URL=http://localhost:11434

# # Embedding Model Configuration
# EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# # Database Configurations
# DATABASE_URL=sqlite:///./credit_copilot.db

# # Vector Database Configuration
# # Options: chroma | qdrant
# VECTOR_DB_TYPE=chroma
# CHROMA_DB_DIR=./data/chroma_db

# # Security & Authority Thresholds
# CREDIT_OFFICER_AUTHORITY_LIMIT=250000
# AUTH_TOKEN_SECRET=replace_with_a_long_random_secret
# LOAN_OFFICER_PASSWORD=replace_with_a_strong_loan_officer_password
# CREDIT_OFFICER_PASSWORD=replace_with_a_strong_credit_officer_password
# # Server & Environment Configuration
# ENV=development
# PORT=8000
# LOG_LEVEL=INFO

# # LLM Configuration (Adapter Pattern)
# # Options: gemini | groq | ollama | fake
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# OLLAMA_BASE_URL=http://localhost:11434

# # Embedding Model Configuration
# EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# # Database Configurations
# DATABASE_URL=sqlite:///./credit_copilot.db

# # Vector Database Configuration
# # Options: chroma | qdrant
# VECTOR_DB_TYPE=chroma
# CHROMA_DB_DIR=./data/chroma_db

# # Security & Authority Thresholds
# CREDIT_OFFICER_AUTHORITY_LIMIT=250000



# Server & Environment
ENV=development
PORT=8000
LOG_LEVEL=INFO

# LLM (Adapter Pattern) — options: gemini | groq | ollama | fake
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434

# Relational DB
DATABASE_URL=sqlite:///./credit_copilot.db

# Vector DB — options: chroma | qdrant
VECTOR_DB_TYPE=chroma
CHROMA_DB_DIR=./data/chroma_db

# Retrieval
RETRIEVAL_TOP_K=5
# Calibrate with: python3 src/cli/calibrate_retrieval.py
RETRIEVAL_MIN_SCORE=0.5664

# Uploads
MAX_UPLOAD_MB=5

# Security & Authority
CREDIT_OFFICER_AUTHORITY_LIMIT=250000
AUTH_TOKEN_SECRET=replace_with_a_long_random_secret
AUTH_TOKEN_EXPIRE_MINUTES=60
LOAN_OFFICER_PASSWORD=replace_with_a_strong_loan_officer_password
CREDIT_OFFICER_PASSWORD=replace_with_a_strong_credit_officer_password
SENIOR_CREDIT_OFFICER_PASSWORD=replace_with_a_strong_senior_credit_officer_password
SCRYPT_N=16384
